appraise "rails-6.1" do
  gem 'railties', '~> 6.1.0'
  gem 'activesupport', '~> 6.1.0'
  # Rails 6.1 fails to boot with concurrent-ruby >= 1.3.5 (it no longer requires logger)
  gem 'concurrent-ruby', '< 1.3.5'
end

